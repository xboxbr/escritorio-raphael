{
  "mcpServers": {
    "linear-game": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${env:AI_LINEAR_GAME}"
      }
    },
    "meshy": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@meshy-ai/meshy-mcp-server"],
      "env": {
        "MESHY_API_KEY": "${env:MESHY_API_KEY}"
      }
    },
    "spritecook": {
      "url": "https://api.spritecook.ai/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:AI_SPRITECOOK_GAME}"
      }
    }
  }
}
